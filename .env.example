# Kopier denne filen til .env.local og fyll inn verdiene.

# Adressen til printeren (Moonraker). Neptune 4 Plus svarer på port 80.
PRINTER_URL=http://192.168.10.111

# Valgfri API-nøkkel. Ikke nødvendig når PC-en er en "betrodd klient" i Moonraker.
MOONRAKER_API_KEY=

# Sett til true for å bruke en simulert printer (utvikling/testing uten å printe).
PRINTER_MOCK=false

# Passord for admin-panelet (/admin). Velg et eget passord.
ADMIN_PASSWORD=

# Lyset ved printerhodet (output_pin). Tom verdi = ingen knapp.
PRINTER_LIGHT_PIN=caselight1

# Klipper-makro som slår topplyset/logo-lyset av og på. Tom verdi = ingen knapp.
PRINTER_TOP_LIGHT_MACRO=MODLELIGHT_SWITCH

# Valgfritt: hvor portalen lagrer data (godkjente utskrifter, innstillinger). Standard: ./data
# DATA_DIR=
